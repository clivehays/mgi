{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/submit.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/reading.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "assets/*.js"
    },
    "api/worksheet.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "worksheets/**"
    },
    "api/ask.js": {
      "maxDuration": 120,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:file",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/assets/consent.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/consent.js?v=4f6b63ac",
      "permanent": false
    },
    {
      "source": "/assets/fonts.css",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/fonts.css?v=1266817b",
      "permanent": false
    },
    {
      "source": "/assets/linkedin.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/linkedin.js?v=e6ea2832",
      "permanent": false
    },
    {
      "source": "/assets/mgi.css",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/mgi.css?v=3a7a6e13",
      "permanent": false
    },
    {
      "source": "/assets/mgi.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/mgi.js?v=64b6bee5",
      "permanent": false
    },
    {
      "source": "/assets/rings.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/rings.js?v=5de45964",
      "permanent": false
    },
    {
      "source": "/assets/scoring.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/scoring.js?v=d18296db",
      "permanent": false
    },
    {
      "source": "/assets/tracking-config.js",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/assets/tracking-config.js?v=60da3861",
      "permanent": false
    },
    {
      "source": "/worksheets/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mgi.cloverera.com"
        }
      ],
      "destination": "https://managergap.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.managergap.com"
        }
      ],
      "destination": "https://managergap.com/$1",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/assessment/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token/ask",
      "destination": "/api/ask?token=:token"
    },
    {
      "source": "/r/:token/worksheet.pdf",
      "destination": "/api/worksheet?token=:token"
    },
    {
      "source": "/r/:token",
      "destination": "/api/reading?token=:token"
    }
  ]
}

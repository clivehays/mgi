{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/submit.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/reading.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/worksheet.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "worksheets/**"
    }
  },
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/worksheets/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mgi.cloverera.com"
        }
      ],
      "destination": "https://managergap.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.managergap.com"
        }
      ],
      "destination": "https://managergap.com/$1",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/assessment/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token/worksheet.pdf",
      "destination": "/api/worksheet?token=:token"
    },
    {
      "source": "/r/:token",
      "destination": "/api/reading?token=:token"
    }
  ]
}
